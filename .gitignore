# -----------------------------------------------------------------------------
*.vvp
*.vcd
*.fst
*.lxt
*.lxt2
*.vpd
*.wlf

# Common simulator-generated working files
work/
transcript
vsim.wlf

# -----------------------------------------------------------------------------
# Build and compiled outputs
# -----------------------------------------------------------------------------
build/
sim/out/
obj_dir/          # Verilator generated build directory
coverage.dat      # Verilator coverage output

