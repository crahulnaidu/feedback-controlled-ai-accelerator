#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x102a1a300 .scope module, "tb_d_reg" "tb_d_reg" 2 1;
 .timescale 0 0;
v0x102a18b10_0 .var "clk", 0 0;
v0x102a1fd70_0 .var "d", 0 0;
v0x102a1fe10_0 .net "q", 0 0, v0x102a189d0_0;  1 drivers
v0x102a1feb0_0 .var "rst", 0 0;
S_0x102a1a480 .scope module, "uut" "d_reg" 2 8, 3 1 0, S_0x102a1a300;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "d";
    .port_info 3 /OUTPUT 1 "q";
v0x102a18890_0 .net "clk", 0 0, v0x102a18b10_0;  1 drivers
v0x102a18930_0 .net "d", 0 0, v0x102a1fd70_0;  1 drivers
v0x102a189d0_0 .var "q", 0 0;
v0x102a18a70_0 .net "rst", 0 0, v0x102a1feb0_0;  1 drivers
E_0xb66c34000 .event posedge, v0x102a18a70_0, v0x102a18890_0;
    .scope S_0x102a1a480;
T_0 ;
    %wait E_0xb66c34000;
    %load/vec4 v0x102a18a70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x102a189d0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x102a18930_0;
    %assign/vec4 v0x102a189d0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x102a1a300;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102a18b10_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x102a18b10_0;
    %inv;
    %store/vec4 v0x102a18b10_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x102a1a300;
T_2 ;
    %vpi_call 2 26 "$dumpfile", "reg_wave.vcd" {0 0 0};
    %vpi_call 2 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x102a1a300 {0 0 0};
    %vpi_call 2 30 "$monitor", "Time=%0t | rst=%b d=%b | q=%b", $time, v0x102a1feb0_0, v0x102a1fd70_0, v0x102a1fe10_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x102a1feb0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102a1fd70_0, 0, 1;
    %delay 12, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102a1feb0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x102a1fd70_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x102a1fd70_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x102a1fd70_0, 0, 1;
    %delay 2, 0;
    %delay 16, 0;
    %vpi_call 2 48 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_reg.v";
    "register.v";
