#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
S_0x10516e3d0 .scope module, "tb_pc" "tb_pc" 2 1;
 .timescale 0 0;
v0x105173520_0 .var "clk", 0 0;
v0x1051735c0_0 .net "pc_out", 31 0, v0x10516ca10_0;  1 drivers
v0x105173660_0 .var "rst", 0 0;
S_0x10516c890 .scope module, "uut" "pc" 2 7, 3 1 0, S_0x10516e3d0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 32 "pc_out";
v0x10516e550_0 .net "clk", 0 0, v0x105173520_0;  1 drivers
v0x10516ca10_0 .var "pc_out", 31 0;
v0x10516cab0_0 .net "rst", 0 0, v0x105173660_0;  1 drivers
E_0x10516d350 .event posedge, v0x10516cab0_0, v0x10516e550_0;
    .scope S_0x10516c890;
T_0 ;
    %wait E_0x10516d350;
    %load/vec4 v0x10516cab0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 32;
    %assign/vec4 v0x10516ca10_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x10516ca10_0;
    %addi 4, 0, 32;
    %assign/vec4 v0x10516ca10_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x10516e3d0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x105173520_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/vec4 v0x105173520_0;
    %inv;
    %store/vec4 v0x105173520_0, 0, 1;
    %jmp T_1.0;
T_1.1 ;
    %end;
    .thread T_1;
    .scope S_0x10516e3d0;
T_2 ;
    %vpi_call 2 22 "$dumpfile", "pc_wave.vcd" {0 0 0};
    %vpi_call 2 23 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x10516e3d0 {0 0 0};
    %vpi_call 2 26 "$monitor", "Time=%0td | rst=%b | PC=0x%h (%0d)", $time, v0x105173660_0, v0x1051735c0_0, v0x1051735c0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x105173660_0, 0, 1;
    %delay 12, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x105173660_0, 0, 1;
    %delay 80, 0;
    %vpi_call 2 35 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_pc.v";
    "pc.v";
